# ── App ──────────────────────────────────────────────────────────
APP_NAME=CareerForge AI
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# ── Security ──────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── MongoDB ───────────────────────────────────────────────────────
# MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=careerforge

# ── OpenAI ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1500
AI_ENABLED=true

# ── Redis (optional) ──────────────────────────────────────────────
# Leave blank to use in-memory cache fallback
REDIS_URL=
CACHE_TTL_SECONDS=3600

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=50
RATE_LIMIT_WINDOW_SECONDS=3600

# ── File Uploads ──────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads

# ── CORS ──────────────────────────────────────────────────────────
# Add your frontend URL(s) here
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","https://your-app.vercel.app"]
